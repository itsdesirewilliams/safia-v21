# Never ship local secrets or the generated Vercel token to a deployment.
.env*
!.env.example

# Local build / tooling artifacts.
.next
node_modules
supabase/.temp
supabase/.branches

# Source media is copied into src/app/fonts and public/ at build time.
# Anchor to the repo root so served copies under public/assets/ are not
# excluded from the deployment.
/assets

# VCS internals.
.git
.gitignore
