# ---------------------------------------------------------------------------
# Safeway Tyre — environment configuration
#
# Copy to `.env.local` and fill in. Never commit real values.
# Values not supplied by Safeway are flagged in `docs/missing-inputs.md`
# and left empty rather than invented.
# ---------------------------------------------------------------------------

# --- Supabase (ADR-0001) ----------------------------------------------------
# Public project URL and anon key are exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key is server-only. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Company contact (public) ----------------------------------------------
# Physical address / map location (supplied input).
NEXT_PUBLIC_COMPANY_ADDRESS=

# --- Social links (public) --------------------------------------------------
# Only set the platforms Safeway has confirmed. Unset platforms are omitted
# from the footer rather than invented.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_PINTEREST=

# --- Homepage Instagram feed (ADR-0008) -------------------------------------
# Long-lived Instagram Graph API access token (server-only).
INSTAGRAM_ACCESS_TOKEN=

# --- Homepage video ---------------------------------------------------------
# YouTube video ID for the homepage "See Safeway in Action" embed.
YOUTUBE_VIDEO_ID=

# --- Contact form email transport (ADR-0007) --------------------------------
# Provider deferred; shape recorded here. Server-only.
EMAIL_TRANSPORT_HOST=
EMAIL_TRANSPORT_PORT=
EMAIL_TRANSPORT_USER=
EMAIL_TRANSPORT_PASSWORD=
EMAIL_TRANSPORT_FROM=
